{
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.key)",
      "Read(**/*.pem)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/terraform.tfvars)",
      "Read(**/.npmrc)",
      "Read(**/.pypirc)",
      "Read(**/appsettings.*.json)",
      "Read(**/secrets.yml)",
      "Read(**/secrets.yaml)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/redact-sensitive-hook.py",
            "statusMessage": "Checking sensitive file access policy..."
          }
        ]
      }
    ]
  }
}
